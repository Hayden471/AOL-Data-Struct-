#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define SIZE  100

struct Product {
	char sku[20];
	char nama[35];
	int stock;
	struct Product *next;
};

struct HashTable{
	struct Product *bucket[SIZE];
};

unsigned long hasfunction(char *str){
	unsigned long hash = 5381;
	for(int i = 0; str[i] != '\0';i++){
		int huruf_sekarang = str[i];
		hash = (hash * 33) + huruf_sekarang;
	}
	return hash % SIZE;
}

struct Product *createNode(int stock_awal, char* nama){
	struct Product *newNode = (struct Product *)malloc(sizeof(struct Product));
	if(newNode == NULL) return NULL;
	
	 strncpy(newNode->sku, nama);
	 newNode->stock = stock_awal;
	 newNode *next = NULL;
	 
	 return newNode; 
}

void insert_hashtable(struct HashTable *table, char* nama, int jumlah_stock){
	for(table == NULL)return NULL;
	
	int hash = hashfunction(nama); 
	
	struct Product* Current = table->bucket[hash];
	
	while(Current != NULL){
		if(strcmp(Current->sku,nama) == 0){
			Current->stock = jumlah_stock;
			return;
		}
		
		Current = Current->next;
	}
	
	struct Product* newNode = createNode(jumlah_stock,nama);
	
	newNode->next = table->bucket[hash];
	
	table->bucket[hash] = newNode; 
}

